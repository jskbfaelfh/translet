# ─── Core Flask ───────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this
JWT_SECRET_KEY=your-jwt-secret-key-change-this
FLASK_ENV=production

# ─── Database (Railway PostgreSQL — يُعطيك Railway هذه القيمة تلقائياً) ───
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── File Storage (اختر واحدة) ────────────────────────────────
# الخيار 1: Cloudflare R2 (موصى به للإنتاج)
USE_LOCAL_STORAGE=False
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=lith-slides
R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev

# الخيار 2: تخزين محلي (للاختبار فقط — لا يُنصح به في Production)
# USE_LOCAL_STORAGE=True

# ─── Translation ──────────────────────────────────────────────
# اختياري: Google Cloud Translate (أفضل جودة)
# GOOGLE_APPLICATION_CREDENTIALS=/app/google-credentials.json

# ─── Limits ───────────────────────────────────────────────────
FREE_PAGES_LIMIT=15
